{
	"name": "jobtracker-api",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "bun run --hot src/index.ts",
		"start": "bun run src/index.ts",
		"build": "bun build src/index.ts src/db/seed.ts --outdir=dist --target=bun --root src",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"seed": "bun run src/db/seed.ts",
		"check": "biome check .",
		"check:fix": "biome check --write ."
	},
	"dependencies": {
		"drizzle-kit": "^0.31.9",
		"drizzle-orm": "^0.45.1",
		"hono": "^4.11.9",
		"postgres": "^3.4.8",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.2",
		"@types/bun": "^1.3.9",
		"bun-types": "^1.3.9"
	}
}
