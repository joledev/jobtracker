# PostgreSQL connection string
# Required by docker-compose.yml, which fails fast without it
POSTGRES_PASSWORD=YOUR_SECURE_PASSWORD

DATABASE_URL=postgresql://jobtracker:YOUR_SECURE_PASSWORD@localhost:5432/jobtracker

# Port for the Hono API server
PORT=3000

# Master API key for bootstrap (used by seed script)
# Generate with: openssl rand -hex 32
MASTER_API_KEY=

# Number of reverse proxies in front of the API (the bundled nginx is 1).
# Leave at 0 only when the API is exposed directly, with no proxy: behind one,
# the rate limiter would otherwise see every request as coming from the proxy
# and apply a single shared limit to all clients.
# Set this to 0 if you expose port 3000 directly instead of going through the
# bundled nginx (Option 2 in docs/SELF-HOSTING.md).
TRUST_PROXY=1
