# Maintainer: Joel Ernesto Lopez Verdugo <contacto@joledev.com>
#
# Empaqueta JobTracker desde el codigo fuente local, no desde la release de
# GitHub: la v1.0.0 es anterior a los arreglos de septiembre de 2026 y arrastra
# la lista de ofertas vacia en modo local y el cambio de etapa sin transaccion.
#
# Uso:  cd packaging/arch && makepkg -si

pkgname=jobtracker
pkgver=1.1.0
pkgrel=1
pkgdesc="Seguimiento de postulaciones de trabajo (Tauri + React)"
arch=('x86_64')
url="https://github.com/joledev/jobtracker"
license=('MIT')
# webkit2gtk-4.1 y gtk3 los necesita el binario en tiempo de ejecucion.
depends=('webkit2gtk-4.1' 'gtk3' 'libappindicator' 'librsvg')
optdepends=(
  'bubblewrap: aisla pdflatex del sistema de archivos al compilar un CV; sin el, una plantilla hostil puede leer archivos locales'
  'texlive-latex: compilar los CV en LaTeX desde la aplicacion'
)
makedepends=('rust' 'cargo' 'pnpm' 'nodejs')
provides=('jobtracker')
conflicts=('jobtracker-bin')
options=('!strip' '!debug')
PACKAGER="Joel Ernesto Lopez Verdugo <contacto@joledev.com>"

# Se construye desde el arbol de trabajo, no desde una fuente descargada.
#
# `startdir` esta desaconsejado por `man 5 PKGBUILD` ("use of this variable is
# deprecated and strongly discouraged"), asi que la ruta se resuelve desde la
# ubicacion del propio PKGBUILD, estable sin importar desde donde se invoque.
_pkgbuild_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
_srcdir="${_pkgbuild_dir}/../.."

prepare() {
  # Las dependencias se obtienen aqui, no en build(): un build en chroot limpio
  # no tiene red durante la compilacion.
  cd "${_srcdir}/apps/desktop"
  pnpm install --frozen-lockfile
}

build() {
  cd "${_srcdir}/apps/desktop"
  # Solo el binario. El empaquetado AppImage no se usa aqui por dos motivos:
  # makepkg ya produce el paquete, y Tauri documenta que el AppImage debe
  # construirse sobre el sistema base mas antiguo soportado (el CI usa Ubuntu),
  # no sobre una distribucion rolling como Arch.
  pnpm tauri build --no-bundle
}

package() {
  cd "${_srcdir}/apps/desktop/src-tauri/target/release"
  install -Dm755 jobtracker-desktop "${pkgdir}/usr/bin/jobtracker"

  install -Dm644 "${_srcdir}/apps/desktop/src-tauri/icons/128x128@2x.png" \
    "${pkgdir}/usr/share/icons/hicolor/256x256/apps/jobtracker.png"

  install -Dm644 /dev/stdin "${pkgdir}/usr/share/applications/jobtracker.desktop" <<'DESKTOP'
[Desktop Entry]
Type=Application
Name=JobTracker
Comment=Seguimiento de postulaciones de trabajo
Exec=/usr/bin/jobtracker
Icon=jobtracker
Terminal=false
Categories=Office;ProjectManagement;
StartupWMClass=JobTracker
DESKTOP

  if [ -f "${_srcdir}/LICENSE" ]; then
    install -Dm644 "${_srcdir}/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  fi

  # Con pkgver fijo, dos compilaciones de commits distintos se reportan igual en
  # `pacman -Qi`. Este archivo deja constancia de que codigo se instalo.
  local _commit
  _commit="$(git -C "${_srcdir}" rev-parse --short HEAD 2>/dev/null || echo desconocido)"
  install -Dm644 /dev/stdin "${pkgdir}/usr/share/${pkgname}/BUILD_INFO" <<INFO
commit: ${_commit}
fecha:  $(date -u +%Y-%m-%dT%H:%M:%SZ)
origen: arbol de trabajo local (${_srcdir})
INFO
}
